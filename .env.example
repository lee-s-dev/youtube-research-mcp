# YouTube Data API v3 key
# Required for: search_videos, get_video_comments, collect_video_discussion,
#               collect_research_sources, collect_research_discussions, get_quota_usage
# Without a key: get_transcript, analyze_videos, and analyze_channel still work via yt-dlp.
#
# How to get one:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project → Enable "YouTube Data API v3"
#   3. Create an API key → paste it below
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Path to the SQLite cache database.
# Relative paths are resolved from this project's root directory, not the MCP client's cwd.
YOUTUBE_RESEARCH_CACHE_DB=data/cache.db
